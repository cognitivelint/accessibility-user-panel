{
  "name": "accessibility-user-panel",
  "version": "0.1.0",
  "description": "Token-conscious AI layer on Playwright + axe-core for Cursor and Claude inbuilt models.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "aup": "./bin/aup.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "agents",
    "skills",
    "schemas",
    ".cursor",
    ".claude",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist reports evidence coverage",
    "cli": "tsx src/cli.ts",
    "aup": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts run",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "demo:serve": "tsx fixtures/demo-app/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "commander": "^14.0.0",
    "playwright": "^1.54.2",
    "tsx": "^4.20.3",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
